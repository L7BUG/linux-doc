# ==================================================
# 开发机 B（家里）.env 配置
# 复制此文件为 .env 后修改下面的值
# ==================================================

# 集群令牌（和公司开发机保持一致！）
K3S_TOKEN=k3s-cluster-token-2026

# 公司开发机的 Tailscale IP（第二个 server 用 --server 加入）
K3S_SERVER_IP=100.64.0.1

# 本机 Tailscale IP
# K3S_SERVER_IP 在 agent 的 --server 参数中使用
# 这里指向公司开发机，agent 通过它加入集群

# 节点主机名
K3S_HOSTNAME=k3s-server-home
K3S_AGENT_HOSTNAME=k3s-agent-home

# Server 启动参数（家里开发机是第二个 server，用 --server 加入）
K3S_SERVER_FLAGS=--server https://100.64.0.1:6443 --tls-san=100.64.0.1 --tls-san=100.64.0.2 --node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik
