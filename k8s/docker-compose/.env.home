# ==================================================
# 家里开发机 .env（第二个 Server）
# 复制此文件为 .env 后修改节点名
# ==================================================

# ---- Tailscale 节点名对照表 ----
# pc1 = 公司开发机（你的主力机，很少关机）
# pc2 = 家里开发机（这台机器）
# sv1 = 云服务器 B（4C/4G，7×24 在线）
# sv2 = 云服务器 A（2C/2G，7×24 在线）
#
# 在 Tailscale 后台（login.tailscale.com/admin/machines）
# 给每台机器改成对应的名字，确保 ping pc1 能通。
# ==================================================

# 集群令牌（必须和公司开发机一致！）
K3S_TOKEN=k3s-cluster-token-2026

# 公司开发机的 Tailscale 节点名（通过它加入集群）
K3S_SERVER_HOST=pc1

# 本机 Tailscale 节点名
K3S_NODE_HOST=pc2

# K3s 内部主机名（用来区分节点，随便起）
K3S_HOSTNAME=k3s-server-home
K3S_AGENT_HOSTNAME=k3s-agent-home

# Server 启动参数
# --server = 加入已有集群（指向 pc1）
# --tls-san = API Server 证书允许的访问名（所有节点名都要加）
# --node-ip = 告诉 K3s 用哪个地址通信
K3S_SERVER_FLAGS=--server https://pc1:6443 --tls-san=pc1 --tls-san=pc2 --tls-san=sv1 --node-ip=pc2 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=pc2 --flannel-backend=host-gw --disable=traefik
