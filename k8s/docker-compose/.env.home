# ==================================================
# 家里开发机 .env（第三个 Server，加入已有集群）
# 复制此文件为 .env 后修改 IP
# ==================================================

# ---- Tailscale 节点名 + IP 对照表 ----
# sv1 = 云服务器 B（4C/4G，7×24 在线，集群 leader）→ 100.x.x.x
# pc1 = 公司开发机（你的主力机，很少关机）         → 100.x.x.x
# pc2 = 家里开发机（这台机器）                      → 100.x.x.x
# sv2 = 云服务器 A（2C/2G，7×24 在线）              → 100.x.x.x
#
# 在 Tailscale 后台（login.tailscale.com/admin/machines）查 IP
# 或在任意节点执行：tailscale status
# ==================================================

# 集群令牌（必须和 sv1 上的保持一致！）
K3S_TOKEN=k3s-cluster-token-2026

# ---- 节点地址（需要填 Tailscale IP）----
K3S_NODE_IP=100.64.0.2               # pc2 的 Tailscale IP

# K3s 内部主机名（用来区分节点，随便起）
K3S_HOSTNAME=k3s-server-home
K3S_AGENT_HOSTNAME=k3s-agent-home

# Server 启动参数
# --server = 加入已有集群（指向 sv1，集群 leader）
K3S_SERVER_FLAGS=--server https://sv1:6443 --tls-san=pc1 --tls-san=pc2 --tls-san=sv1 --node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik
