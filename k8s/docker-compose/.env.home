# ==================================================
# 家里开发机 .env（第二个 Server）
# 复制此文件为 .env 后修改 Tailscale IP
# ==================================================

# 集群令牌（和公司开发机保持一致！）
K3S_TOKEN=k3s-cluster-token-2026

# 公司开发机的 Tailscale IP（agent 通过它加入集群）
K3S_SERVER_IP=100.64.0.1

# 本机 Tailscale IP（Server 和 Agent 都用这个）
K3S_NODE_IP=100.64.0.2

# 节点主机名
K3S_HOSTNAME=k3s-server-home
K3S_AGENT_HOSTNAME=k3s-agent-home

# Server 启动参数（第二个 server，--server 加入已有集群）
K3S_SERVER_FLAGS=--server https://100.64.0.1:6443 --tls-san=100.64.0.1 --tls-san=100.64.0.2 --tls-san=100.64.0.10 --node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.2 --flannel-backend=host-gw --disable=traefik
