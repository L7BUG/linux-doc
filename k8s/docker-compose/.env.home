# ==================================================
# 家里开发机 .env（Agent 节点，加入集群）
# 复制此文件为 .env 后修改 IP
# ==================================================

# ---- Tailscale 节点名 + IP 对照表 ----
# sv1 = 云服务器 B（4C/4G，集群 leader）→ 查 Tailscale 获取 IP
# pc1 = 公司开发机                       → 查 Tailscale 获取 IP
# pc2 = 家里开发机（这台机器）           → 查 Tailscale 获取 IP
# sv2 = 云服务器 A（2C/2G）              → 查 Tailscale 获取 IP
# ==================================================

# 集群令牌（必须和 sv1 上的一致！）
K3S_TOKEN=k3s-cluster-token-2026

# K3s 内部主机名
K3S_HOSTNAME=agent-home

# Agent 启动参数
# --server = 指向集群 leader（sv1 的 IP）
# --node-ip = 本机 Tailscale IP
K3S_AGENT_FLAGS=--server https://<sv1的Tailscale-IP>:6443 --node-ip=<pc2的Tailscale-IP>
