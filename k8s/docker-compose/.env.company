# ==================================================
# 公司开发机 .env（Agent 节点，加入集群）
# 复制此文件为 .env 后修改 IP
# ==================================================

# ---- Tailscale 节点名 + IP 对照表 ----
# sv1 = 云服务器 B（4C/4G，集群 leader）→ 查 Tailscale 获取 IP
# pc1 = 公司开发机（这台机器）           → 查 Tailscale 获取 IP
# pc2 = 家里开发机                       → 查 Tailscale 获取 IP
# sv2 = 云服务器 A（2C/2G）              → 查 Tailscale 获取 IP
# ==================================================

# 集群令牌（所有节点必须一致）
K3S_TOKEN=123
K3S_URL=https://<sv1ip>:6443
NODE_IP=<pc1-ip>
# K3s 内部主机名
K3S_HOSTNAME=agent-company
