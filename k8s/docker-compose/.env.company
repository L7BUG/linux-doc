# ==================================================
# 开发机 A（公司）.env 配置
# 复制此文件为 .env 后修改下面的值
# ==================================================

# 集群令牌（所有节点必须一致，自定义一个复杂字符串）
K3S_TOKEN=k3s-cluster-token-2026

# 本机 Tailscale IP
K3S_SERVER_IP=100.64.0.1

# 节点主机名
K3S_HOSTNAME=k3s-server-company
K3S_AGENT_HOSTNAME=k3s-agent-company

# Server 启动参数（公司开发机是第一个 server，用 --cluster-init）
K3S_SERVER_FLAGS=--cluster-init --tls-san=100.64.0.1 --tls-san=100.64.0.2 --node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik
