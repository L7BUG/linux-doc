# ==================================================
# 公司开发机 .env（第一个 Server）
# 复制此文件为 .env 后修改节点名和 IP
# ==================================================

# ---- Tailscale 节点名 + IP 对照表 ----
# pc1 = 公司开发机（你的主力机，很少关机）     → 100.x.x.x
# pc2 = 家里开发机                              → 100.x.x.x
# sv1 = 云服务器 B（4C/4G，7×24 在线）          → 100.x.x.x
# sv2 = 云服务器 A（2C/2G，7×24 在线）          → 100.x.x.x
#
# 在 Tailscale 后台（login.tailscale.com/admin/machines）查 IP
# 或在任意节点执行：tailscale status
# ==================================================

# 集群令牌（所有节点必须一致）
K3S_TOKEN=k3s-cluster-token-2026

# ---- 节点地址（需要填 Tailscale IP）----
# --node-ip 只接受 IP，不接受主机名
# --server 和 --tls-san 可以用主机名
K3S_NODE_IP=100.64.0.1               # pc1 的 Tailscale IP

# K3s 内部主机名（用来区分节点，随便起）
K3S_HOSTNAME=k3s-server-company
K3S_AGENT_HOSTNAME=k3s-agent-company

# Server 启动参数
# --cluster-init = 初始化嵌入式 etcd（只有第一个 server 需要）
# --tls-san = API Server 证书允许的访问名（可以用主机名）
# --node-ip = K3s 节点地址（必须用 IP）
K3S_SERVER_FLAGS=--cluster-init --tls-san=pc1 --tls-san=pc2 --tls-san=sv1 --node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik
