# ==================================================
# 公司开发机 .env（第一个 Server）
# 复制此文件为 .env 后修改 Tailscale IP
# ==================================================

# 集群令牌（所有节点必须一致）
K3S_TOKEN=k3s-cluster-token-2026

# 本机 Tailscale IP（Server 和 Agent 都用这个）
K3S_NODE_IP=100.64.0.1

# 节点主机名
K3S_HOSTNAME=k3s-server-company
K3S_AGENT_HOSTNAME=k3s-agent-company

# Server 启动参数（第一个 server，--cluster-init 初始化集群）
K3S_SERVER_FLAGS=--cluster-init --tls-san=100.64.0.1 --tls-san=100.64.0.2 --tls-san=100.64.0.10 --node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik

# Agent 启动参数
K3S_AGENT_FLAGS=--node-ip=100.64.0.1 --flannel-backend=host-gw --disable=traefik
